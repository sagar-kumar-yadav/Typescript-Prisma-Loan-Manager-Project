// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OFFICER
  CUSTOMER_SERVICE
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role

  // creator relation (Admin-users)
  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  createdAt  DateTime @default(now())

  loans Loan[] @relation("OfficerLoans")
}

model Borrower {
  id    String @id @default(uuid())
  name  String
  phone String
  email String

  loans Loan[]
}

model Loan {
  id        String   @id @default(uuid())
  amount    Float
  interest  Float
  tenure    Int
  emi       Float
  startDate DateTime
  status    String

  officerId  String
  borrowerId String

  officer  User     @relation("OfficerLoans", fields: [officerId], references: [id])
  borrower Borrower @relation(fields: [borrowerId], references: [id])

  payments Payment[]
}

model Payment {
  id      String    @id @default(uuid())
  dueDate DateTime
  paid    Boolean   @default(false)
  paidAt  DateTime?

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id])
}
